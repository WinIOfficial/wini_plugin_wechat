<Project>
  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">0.1.1</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BaseOutputPath>$(MSBuildThisFileDirectory)artifacts\bin\$(MSBuildProjectName)\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)artifacts\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <ContractsVersion Condition="'$(ContractsVersion)' == ''">0.1.1</ContractsVersion>
    <ContractsProject Condition="'$(ContractsProject)' == '' and '$(ContractsFeed)' == '' and Exists('$(MSBuildThisFileDirectory)..\windowsisland\src\WindowsIsland.Contracts\WindowsIsland.Contracts.csproj')">$(MSBuildThisFileDirectory)..\windowsisland\src\WindowsIsland.Contracts\WindowsIsland.Contracts.csproj</ContractsProject>
    <RestoreAdditionalProjectSources Condition="'$(ContractsFeed)' != ''">$(RestoreAdditionalProjectSources);$(ContractsFeed)</RestoreAdditionalProjectSources>
  </PropertyGroup>
</Project>
