<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup Condition="'$(ContractsProject)' != ''">
    <ProjectReference Include="$(ContractsProject)" Private="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(ContractsProject)' == ''">
    <PackageReference Include="WindowsIsland.Contracts" Version="$(ContractsVersion)" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Wini.Plugin.WeChat.Tests" />
    <InternalsVisibleTo Include="Wini.Plugin.WeChat.DesktopTests" />
  </ItemGroup>
</Project>
